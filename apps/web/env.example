NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Use `supabase status -o env` after `supabase start` to obtain the local URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_publishable_key

# Required for hosted builds so auth links and metadata never fall back to a
# local or incorrect domain. Local browser flows can use window.location.origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
