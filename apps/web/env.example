NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Use `supabase status -o env` after `supabase start` to obtain the local URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_publishable_key

# Optional but recommended for auth callback links in hosted environments.
# In local development the app can fall back to window.location.origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
