# =============================================================================
# Backend environment only
# Copy to .env in the repository root for the FastAPI API and worker.
# Frontend public variables live in apps/web/.env.local (see apps/web/env.example).
# =============================================================================

# =============================================================================
# Required provider secrets and URLs
# =============================================================================
OPENROUTER_API_KEY=
GROQ_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=  # required in staging/production for readiness and worker wake-ups
SUPABASE_DB_USER=
SUPABASE_DB_NAME=
SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432  # Supabase CLI local development uses 54322

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL=
POLAR_PORTAL_RETURN_URL=

# =============================================================================
# Optional provider/runtime config
# =============================================================================
APP_ENV=local                 # set to staging or production in hosted API/worker deployments
CORS_ALLOW_ORIGINS=http://localhost:3000  # replace with exact HTTPS origins when hosted
# RATE_LIMIT=60  # base requests per minute, 0 = disabled. Expensive writes are stricter; only Polar webhooks and /meta/health are exempt.
# TRUST_PROXY_HEADERS=false  # enable only behind a trusted ingress/proxy
# TRUSTED_PROXY_NETWORKS=10.0.0.0/8  # comma-separated; required with TRUST_PROXY_HEADERS=true
# POLAR_CHECKOUT_RETURN_URL=
# POLAR_SERVER=sandbox
# BILLING_DEBT_CAP_SECONDS=600               # accepted range: 0-86400
# WORKER_MAX_CONCURRENT_JOBS=10              # accepted range: 1-64
# WORKER_SHUTDOWN_GRACE_SECONDS=30          # stop claiming, drain, then cancel in-flight jobs
# SOURCE_DOWNLOAD_DEADLINE_SECONDS=600       # total YouTube audio download deadline
# SOURCE_METADATA_DEADLINE_SECONDS=30         # total YouTube metadata/admission deadline
# PROVIDER_TRANSCRIPTION_DEADLINE_SECONDS=190  # total deadline across bounded Groq attempts
# PROVIDER_SUMMARY_DEADLINE_SECONDS=1805       # total deadline across bounded OpenRouter attempts
# SSE_MAX_STREAMS_PER_USER=3                   # shared active stream cap across API replicas
# SSE_MAX_STREAMS_PER_IP=12
# SSE_STREAM_LEASE_SECONDS=90
# SSE_STREAM_MAX_LIFETIME_SECONDS=3600         # clients reconnect after this bounded lifetime

# =============================================================================
# Optional logging config
# =============================================================================
# Leave this unset locally unless you need JSON logs.
# In production, prefer LOG_FORMAT=json.
#
# LOG_FORMAT=console    # console by default; use json for hosted production logs
