{
  "name": "fathom",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "pnpm --filter @fathom/web dev",
    "build:web": "pnpm --filter @fathom/web build",
    "start:web": "pnpm --filter @fathom/web start",
    "lint:web": "pnpm --filter @fathom/web lint",
    "typecheck:web": "pnpm --filter @fathom/web typecheck",
    "generate:api-client": "pnpm --filter @fathom/api-client generate"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "minimatch": "10.2.5",
      "ajv@^8.0.0": "8.18.0",
      "flatted": "3.4.2",
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "js-yaml": "4.3.0",
      "ws": "8.21.0",
      "@babel/core": "7.29.6",
      "sharp": "0.35.0",
      "picomatch@^2.3.1": "2.3.2",
      "picomatch@^4.0.0": "4.0.4"
    }
  },
  "packageManager": "pnpm@10.33.2"
}
